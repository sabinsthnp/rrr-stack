ations":["ces,eng,pt"],"image":"https://artworks.thetvdb.com/banners/v4/season/2136511/posters/67887d6b6875d.jpg","imageType":7,"companies":[{"id":0,"primaryCompanyType":0}]}],"translations":{"nameTranslations":[{"name":"Severance","language":"eng","IsPrimary":true},{"name":"Разделение","language":"rus","IsPrimary":false},{"name":"Severance","language":"fra","IsPrimary":false},{"name":"Διαχωρισμός","language":"ell","IsPrimary":false},{"name":"Separación","language":"spa","IsPrimary":false},{"name":"Separação","language":"por","IsPrimary":false},{"name":"Severance","language":"deu","IsPrimary":false},{"name":"Severance","language":"swe","IsPrimary":false},{"name":"Severance","language":"heb","IsPrimary":false},{"name":"Scissione","language":"ita","IsPrimary":false},{"name":"انفصال","language":"ara","IsPrimary":false},{"name":"Ruptura","language":"pt","IsPrimary":false},{"name":"Severance - Erotus","language":"fin","IsPrimary":false},{"name":"Severance","language":"tur","IsPrimary":false},{"name":"Rozdzielenie","language":"pol","IsPrimary":false},{"name":"세브란스: 단절","language":"kor","IsPrimary":false},{"name":"人生切割术","language":"zho","IsPrimary":false},{"name":"Odloučení","language":"ces","IsPrimary":false},{"name":"Dissociation","isAlias":"true","language":"fra","IsPrimary":false},{"name":"セヴェランス","language":"jpn","IsPrimary":false},{"name":"Atskyrimas","language":"lit","IsPrimary":false},{"name":"الشطر","isAlias":"true","language":"ara","IsPrimary":false},{"name":"Különválás","language":"hun","IsPrimary":false}],"overviewTranslations":[{"overview":"Mark leads a team of office workers whose memories have been surgically divided between their work and personal lives. When a mysterious colleague appears outside of work, it begins a journey to discover the truth about their jobs.","language":"eng","IsPrimary":true},{"overview":"Руководство компании Lumen Industries придумало новый способ контролировать повседневную деятельность своих сотрудников — «процедуру разделения», отделяющую рабочие воспоминания от обычных. Хелли соглашается на процедуру, но теперь начинает сомневаться в правильности своего выбора.","language":"rus","IsPrimary":false},{"overview":"Mark dirige une équipe d'employés de bureau dont les souvenirs ont été scindés chirurgicalement en fonction de leur vie professionnelle et de leur vie privée. L'irruption d'un mystérieux collègue en dehors du bureau enclenche une longue quête de vérité sur leur travail.","language":"fra","IsPrimary":false},{"overview":"Ο Μαρκ ηγείται μιας ομάδας υπαλλήλων των οποίων οι αναμνήσεις έχουν διαχωριστεί χειρουργικά σε αναμνήσεις δουλειάς και προσωπικής ζωής. Όταν ένας μυστηριώδης συνάδελφος εμφανίζεται εκτός δουλειάς, ξεκινά ένα ταξίδι για να ανακαλύψει την αλήθεια για τις δουλειές τους.","language":"ell","IsPrimary":false},{"overview":"Ambientada en Lumen Industries, una empresa que busca llevar el equilibrio entre la vida personal y la laboral a un nuevo nivel con un nuevo procedimiento que separa sus memorias del trabajo y del empleo.","language":"spa","IsPrimary":false},{"overview":"Mark lidera uma equipa de funcionários de escritório cujas memórias foram cirurgicamente divididas entre os seus empregos e as suas vidas pessoais. Quando um misterioso colega aparece fora do trabalho, inicia uma jornada para descobrir a verdade sobre os seus empregos.","language":"por","IsPrimary":false},{"overview":"Mark (Adam Scott) ist ein neuer Mitarbeiter bei Lumen Industries. Dort will man die vielbeschworene Work-Life-Balance auf ein neues Niveau bringen. Doch Marks düstere Vergangenheit behindert seinen Neuanfang. (Text: RD)","language":"deu","IsPrimary":false},{"overview":"Mark leder ett team av kontorsarbetare vars minnen har splittrats kirurgiskt mellan deras arbetsliv och privatliv. När en mystisk kollega dyker upp utanför arbetstid påbörjas en resa för att upptäcka sanningen om deras jobb.","language":"swe","IsPrimary":false},{"overview":"מארק סקאוט מנהל צוות של עובדי משרד שזיכרונם פוצל באופן כירורגי בין העבודה לבין חייהם האישיים. כשאיש צוות מסתורי מופיע מחוץ לעבודה, מתחיל מסע לגילוי האמת על העבודה שלהם.","language":"heb","IsPrimary":false},{"overview":"All’interno della Lumon Industries Mark Scout è a capo di un team che è stato sottoposto a un esperimento scientifico. Tutti i dipendenti infatti hanno ricevuto un trattamento grazie al quale i ricordi lavorativi sono stati chirurgicamente separati da quelli personali. La cosa però non è di aiuto, anzi: nel momento in cui Mark dovrà affrontare un mistero, si troverà di fronte a un conflitto che lo porterà a rimettere in discussione sia il lavoro che se stesso.","language":"ita","IsPrimary":false},{"overview":"يقود “مارك” فريقًا من العاملين في المكاتب الذين تم تقسيم ذكرياتهم جراحيًا بين حياتهم العملية والشخصية، لكن عندما يظهر زميل غامض له خارج العمل، تبدأ رحلته لاكتشاف حقيقة وظيفتهم.","language":"ara","IsPrimary":false},{"overview":"Mark lidera uma equipe de funcionários de escritório cujas memórias foram divididas cirurgicamente entre a vida no trabalho e a vida pessoal. Quando um colega de trabalho misterioso aparece fora do escritório, ele começa uma jornada para descobrir a verdade sobre seu trabalho.\r\n\r\n","language":"pt","IsPrimary":false},{"overview":"Mark johtaa toimistotyöntekijöiden tiimiä firmassa, joka velvoittaa työntekijät keskittymään yhteen asiaan kerrallaan. Kokeellisesta kirurgisesta operaatiosta johtuen alaiset eivät kykene muistamaan vapaa-aikaa työajalla, eivätkä toisaalta työaikaa vapaa-ajalla. Luonnollisesti kaikki on pielessä tässä järjestelyssä. Sitten koittaa päivä, kun Mark tapaa vapaa-ajallaan salaperäisen kollegan, joka paljastaa heidän tekemänsä työn todellisen luonteen.","language":"fin","IsPrimary":false},{"overview":"Lumen Industries isimli hayali şirket ve çalışanları etrafında şekillenecek dizide, iş ve hayat arasındaki dengeyi yeni bir seviyeye taşıyan “ikiye ayırma prosedürü” isimli bir işlem konu ediliyor. Bu prosedür sayesinde Lumen Industries çalışanları iş ve işle ilgisi olmayan anılarını, hafızalarında birbirinden ayrı şekilde muhafaza edebiliyor.","language":"tur","IsPrimary":false},{"overview":"Mark zarządza zespołem pracowników, których wspomnienia związane z pracą i życiem osobistym zostały rozdzielone w wyniku zabiegu. Gdy po pracy zjawia się w jego życiu tajemniczy kolega, Mark zaczyna stopniowo odkrywać prawdę na temat ich zawodów.","language":"pol","IsPrimary":false},{"overview":"마크는 시술로 직장 생활과 사생활의 기억이 나뉜 사람들로 이루어진 부서의 팀장이다. 회사 밖에서 의문에 쌓인 동료가 나타나면서 그들의 일에 대한 진실을 밝히는 여정이 시작된다.\r\n","language":"kor","IsPrimary":false},{"overview":"　　故事发生在一家名为卢蒙的超级大公司内，一种名为记忆分割术的全新技术正在公司内部进行实验，接受了手术的员工将进行人格分离手术，形成公司人格和日常人格，当踏进公司大门的那一刻，他们的日常人格就会陷入沉睡，身体由公司人格主导。相对的，在离开公司的那一刻，日常人格会重新接管身体，当然，这个人格不会记得任何在公司里发生的事情。\r\n　　马克（亚当·斯科特 Adam Scott 饰）、迪伦（扎克·切利 Zach Cherry 饰）和埃尔文（约翰·特托罗 John Turturro 饰）三人都接受了分离手术，这一天，他们所在的部门迎来了一位名叫海莉（布丽特·洛薇尔 Britt Lower 饰）的新同事，她身上的反叛气质打破了长久萦绕在这个部门，以及整个公司内的平静。","language":"zho","IsPrimary":false},{"overview":"Mark šéfuje týmu zaměstnanců, kterým byla chirurgicky oddělena pracovní a mimopracovní paměť. Po setkání s kolegou z práce v osobním životě se vydává na cestu k pravdě o jejich zaměstnání.","language":"ces","IsPrimary":false},{"overview":"謎めいた製薬企業「ルーモン産業」は、「セヴェランス」と呼ばれる外科手術を用いて、一部の社員の仕事と私生活の記憶を分離している。「セヴェランス」を受けた社員の一人であるマークは、会社の中と外の両方から、その裏に潜む陰謀を解き明かしていく。","language":"jpn","IsPrimary":false},{"overview":"Markas vadovauja biuro darbuotojų komandai, kurių prisiminimai chirurginiu būdu buvo padalinti į darbą ir asmeninį gyvenimą. Kai ne darbo aplinkoje pasirodo paslaptingas kolega, prasideda tiesos paieškos apie savo darbus.","language":"lit","IsPrimary":false},{"overview":"Mark irodavezető egy olyan helyen, ahol a dolgozók munkahelyi és magánéleti emlékeit műtéti úton kettéválasztották. Amikor egy titokzatos kolléga felbukkan a munkahelyen kívül, elkezdődik egy utazás, amely feltárja az igazságot a munkájukkal kapcsolatban.","language":"hun","IsPrimary":false}],"aliases":"[Dissociation,الشطر]"},"tags":[{"id":63,"tag":3,"tagName":"TV Type or Format","name":"Story-based Drama","helpText":"Drama series where you must watch all episodes in order. Ex: Game of Thrones, The Walking Dead, Killing Eve"},{"id":160,"tag":9,"tagName":"Relationship Types","name":"Co-workers"},{"id":542,"tag":11,"tagName":"Setting","name":"Workplace","helpText":"An office or other generic place of work."},{"id":158,"tag":9,"tagName":"Relationship Types","name":"Boss/Employee"},{"id":155,"tag":9,"tagName":"Relationship Types","name":"Brother/Sister"}],"contentRatings":[{"id":26,"name":"14","country":"bra","description":"Suitable for viewers over the age of 14","contentType":"","order":0},{"id":40,"name":"18+","country":"can","description":"Programming intended for viewers ages 18 and older","contentType":"","order":0},{"id":81,"name":"12","country":"grc","description":"Suitable for ages 12 and up","contentType":"","order":0},{"id":120,"name":"18+","country":"isr","description":"Suitable only for adults","contentType":"","order":0},{"id":177,"name":"M16","country":"prt","description":"Suitable for viewers aged 16 and older","contentType":"","order":0},{"id":247,"name":"TV-MA","country":"usa","description":"Not suitable for children and teens under 17","contentType":"","order":0}],"seasonTypes":[{"id":1,"name":"Aired Order","type":"official"}]}