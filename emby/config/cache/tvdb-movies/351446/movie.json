ype":4,"sourceName":"Official Website"},{"id":"1203329","type":10,"sourceName":"TheMovieDB.com"},{"id":"The_Witcher:_Sirens_of_the_Deep","type":24,"sourceName":"Wikipedia"}],"characters":[{"id":69296029,"name":"Geralt of Rivia","peopleId":361332,"movieId":"351446","type":3,"image":"https://artworks.thetvdb.com/banners/v4/actor/361332/photo/67accdd1be3f0.jpg","sort":1,"isFeatured":true,"url":"361332-doug-cockle","peopleType":"Actor","personName":"Doug Cockle","personImgURL":"https://artworks.thetvdb.com/banners/v4/actor/361332/photo/6501c8afea624.jpg"},{"id":69296031,"name":"Jaskier","peopleId":631769,"movieId":"351446","type":3,"image":"https://artworks.thetvdb.com/banners/v4/actor/631769/photo/67acce37d42b4.jpg","sort":2,"isFeatured":true,"url":"631769-joey-batey","peopleType":"Actor","personName":"Joey Batey","personImgURL":"https://artworks.thetvdb.com/banners/v4/actor/631769/photo/61916758b5f1d.jpg"},{"id":69296033,"name":"Yennefer of Vengerberg","peopleId":8014321,"movieId":"351446","type":3,"image":"https://artworks.thetvdb.com/banners/v4/actor/8014321/photo/67acce12d5267.jpg","sort":3,"isFeatured":true,"url":"8014321-anya-chalotra","peopleType":"Actor","personName":"Anya Chalotra","personImgURL":"https://artworks.thetvdb.com/banners/v4/actor/8014321/photo/608e43d719cc6.jpg"},{"id":69296037,"name":"Essi Daven","peopleId":8046968,"movieId":"351446","type":3,"image":"https://artworks.thetvdb.com/banners/v4/actor/8046968/photo/67accf15b5792.jpg","sort":4,"isFeatured":false,"url":"8046968-christina-wren","peopleType":"Actor","personName":"Christina Wren","personImgURL":"https://artworks.thetvdb.com/banners/v4/actor/8046968/photo/678ea812af1cc.jpg"},{"id":69303614,"peopleId":7878767,"movieId":"351446","type":2,"image":"","sort":5,"isFeatured":false,"url":"7878767-mike-ostrowski","peopleType":"Writer","personName":"Mike Ostrowski","personImgURL":""},{"id":69303615,"peopleId":9115536,"movieId":"351446","type":2,"image":"","sort":6,"isFeatured":false,"url":"9115536-rae-benjamin","peopleType":"Writer","personName":"Rae Benjamin","personImgURL":""},{"id":69303616,"peopleId":7864949,"movieId":"351446","type":7,"image":"","sort":7,"isFeatured":false,"url":"7864949-lauren-schmidt-hissrich","peopleType":"Producer","personName":"Lauren Schmidt Hissrich","personImgURL":""},{"id":69306820,"name":"Sh’eenaz","peopleId":8157551,"movieId":"351446","type":3,"image":"https://artworks.thetvdb.com/banners/v4/actor/8157551/photo/67accfe740bba.jpg","sort":8,"isFeatured":false,"url":"8157551-emily-carey","peopleType":"Actor","personName":"Emily Carey","personImgURL":"https://artworks.thetvdb.com/banners/v4/actor/8157551/photo/631326767b49f.jpg"}],"budget":"0.00","boxOffice":"0.00","originalCountry":"usa","originalLanguage":"eng","tagOptions":"[{id:33,tag:2,tagName:Sub-Genre,name:Adult Animation,helpText:null}]","lists":[],"translations":{"nameTranslations":[{"name":"The Witcher: Sirens of The Deep","language":"eng","IsPrimary":true},{"name":"The Witcher : Les sirènes des abysses","language":"fra","IsPrimary":false},{"name":"The Witcher: Sereias das Profundezas","language":"pt","IsPrimary":false},{"name":"The Witcher: Sirens of the Deep","language":"por","IsPrimary":false},{"name":"The Witcher: Sirens of the Deep","language":"deu","IsPrimary":false},{"name":"The Witcher: Sirenas de las profundidades","language":"spa","IsPrimary":false},{"name":"Ο Γητευτής: Οι Σειρήνες της Αβύσσου","language":"ell","IsPrimary":false},{"name":"The Witcher: गहराई की गूंज","language":"hin","IsPrimary":false},{"name":"The Witcher: Le sirene degli abissi","language":"ita","IsPrimary":false},{"name":"ウィッチャー 深海のセイレーン","language":"jpn","IsPrimary":false},{"name":"Ведьмак: Зов Морской Бездны","language":"rus","IsPrimary":false},{"name":"The Witcher: Sirens of the Deep","language":"tur","IsPrimary":false},{"name":"Wiedźmin: Syreny z głębin","language":"pol","IsPrimary":false}],"overviewTranslations":[{"overview":"Geralt of Rivia, a mutated monster hunter, is hired to investigate a series of attacks in a seaside village and finds himself drawn into a centuries-old conflict between humans and merpeople. He must count on friends — old and new — to solve the mystery before the hostilities between the two kingdoms escalate into an all-out war.","language":"eng","IsPrimary":true},{"overview":"Geralt de Riv, un chasseur de monstres muté, est engagé pour enquêter sur une série d'attaques dans un village balnéaire et se retrouve entraîné dans un conflit vieux de plusieurs siècles entre les humains et les sirènes. Il doit compter sur ses amis – anciens et nouveaux – pour résoudre le mystère avant que les hostilités entre les deux royaumes ne dégénèrent en une guerre totale.","language":"fra","IsPrimary":false},{"overview":"Quando marinheiros humanos são atacados por criaturas misteriosas das profundezas, só uma pessoa pode impedir a guerra entre a terra e o mar: o Witcher, Geralt de Rivia.","language":"pt","IsPrimary":false},{"overview":"Quando marinheiros humanos são atacados por misteriosas criaturas das profundezas, apenas uma pessoa pode pôr fim à guerra entre a terra e o mar: o bruxo Geralt de Rivia.","language":"por","IsPrimary":false},{"overview":"Als menschliche Seeleute von rätselhaften Meereskreaturen attackiert werden, kann nur eine Person den Krieg zwischen Land und Meer stoppen: der Hexer Geralt von Rivia.","language":"deu","IsPrimary":false},{"overview":"Cuando unos misteriosos seres de las profundidades atacan a unos marineros, solo hay alguien que puede impedir que estalle la guerra entre la tierra y el mar: Geralt de Rivia.","language":"spa","IsPrimary":false},{"overview":"Όταν μυστηριώδη πλάσματα του βυθού επιτίθενται σε ναύτες, μόνο ένας μπορεί να σταματήσει τον πόλεμο ανάμεσα στη στεριά και τη θάλασσα: ο Γητευτής, ο Γκέραλτ από τη Ρίβια.","language":"ell","IsPrimary":false},{"overview":"नाविकों पर समुद्र के रहस्यमयी जीवों के हमले के बाद, इंसानों और समुद्री जीवों के बीच छिड़े युद्ध को केवल एक ही व्यक्ति रोक सकता है: विचर, गेराल्ट ऑफ़ रिविया.","language":"hin","IsPrimary":false},{"overview":"Quando i marinai umani sono attaccati da misteriose creature degli abissi, solo una persona può fermare la guerra tra terra e mare: il Witcher, Geralt di Rivia.","language":"ita","IsPrimary":false},{"overview":"人間の船乗りたちが謎の深海生物に襲撃され、陸と海の王国は一触即発に。この戦争を止められるのは、ウィッチャーであるリヴィアのゲラルトただ一人。","language":"jpn","IsPrimary":false},{"overview":"Когда на моряков-людей нападают таинственные существа глубин, остановить войну между сушей и морем может только один человек — Ведьмак Геральт из Ривии.","language":"rus","IsPrimary":false},{"overview":"İnsan denizciler derin sulardaki gizemli yaratıkların saldırısına uğradığında, karayla deniz arasındaki bu savaşı durdurabilecek tek kişi Rivyalı Geralt adlı Witcher'dır.","language":"tur","IsPrimary":false},{"overview":"Geralt z Rivii, zmutowany łowca potworów, zostaje wynajęty do zbadania serii ataków w nadmorskiej wiosce i zostaje wciągnięty w trwający od wieków konflikt między ludźmi a morskimi stworzeniami. Musi zwrócić się do przyjaciół - starych i nowych - aby rozwiązać tę zagadkę, zanim wrogość między dwoma królestwami przerodzi się w wielką wojnę.","language":"pol","IsPrimary":false}]},"companies":{"studio":[],"network":["{id:535,name:Netflix,slug:netflix,nameTranslations:null,overviewTranslations:null,aliases:null,country:usa,primaryCompanyType:1,activeDate:null,inactiveDate:null,companyType:{companyTypeId:1,companyTypeName:Network},parentCompany:{id:null,name:null,relation:{id:null,typeName:null}},tagOptions:null}"],"production":[{"id":40869,"name":"Studio Mir","slug":"studio-mir","country":"kor","primaryCompanyType":3,"companyType":{"companyTypeId":3,"companyTypeName":"Production Company"},"parentCompany":{"relation":{}}},{"id":33693,"name":"Platige Image","slug":"platige-image","primaryCompanyType":3,"companyType":{"companyTypeId":3,"companyTypeName":"Production Company"},"parentCompany":{"relation":{}}}],"distributor":[],"special_effects":[]},"production_countries"