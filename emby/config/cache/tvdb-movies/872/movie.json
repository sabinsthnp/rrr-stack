URL":""}],"budget":"145000000.00","boxOffice":"521200000.00","originalCountry":"chn","originalLanguage":"eng","studios":[{"id":8,"name":"DreamWorks Animation","parentStudio":"7"}],"lists":[{"id":6101,"name":"Kung Fu Panda Franchise","url":"kung-fu-panda","isOfficial":true,"nameTranslations":["deu","eng","spa"],"overviewTranslations":"[deu,spa]","aliases":[],"score":0,"image":"","imageIsFallback":false},{"id":7355,"name":"DreamWorks - Collection","url":"7355","isOfficial":false,"nameTranslations":["eng","por"],"aliases":[],"score":15249346,"image":"","imageIsFallback":false},{"id":7390,"name":"Kung Fu Panda - Collection","url":"7390","isOfficial":false,"nameTranslations":["eng","por"],"aliases":[],"score":2168024,"image":"","imageIsFallback":false},{"id":7634,"name":"DreamWorks","overview":".Just DreamWorks.","url":"7634","isOfficial":false,"nameTranslations":["eng"],"overviewTranslations":"[eng]","aliases":[],"score":0,"image":"","imageIsFallback":false},{"id":14654,"name":"Animated 3D","overview":"","url":"14654","isOfficial":false,"nameTranslations":["eng"],"overviewTranslations":"[eng]","aliases":[],"score":30822720,"image":"","imageIsFallback":false},{"id":15930,"name":"Must Watch","overview":"","url":"15930","isOfficial":false,"nameTranslations":["eng"],"overviewTranslations":"[eng]","aliases":[],"score":156027211,"image":"","imageIsFallback":false},{"id":16060,"name":"Kung Fu Panda Collection","overview":"The Kung Fu Panda series are computer-animated action comedy films set in a version of China populated by humanoid talking animals, the plot revolves around a bumbling humanoid panda named Po who aspires to be a kung fu master.","url":"16060","isOfficial":false,"nameTranslations":["eng"],"overviewTranslations":"[eng]","aliases":[],"score":2402021,"image":"","imageIsFallback":false}],"translations":{"nameTranslations":[{"name":"カンフー・パンダ3","language":"jpn","IsPrimary":false},{"name":"쿵푸팬더 3","language":"kor","IsPrimary":false},{"name":"Кунг-фу Панда 3","language":"rus","IsPrimary":false},{"name":"功夫熊猫3","language":"zho","IsPrimary":false},{"name":"Kung Fu Panda 3.","language":"hun","IsPrimary":false},{"name":"Kung Fu Panda 3","tagline":"O regresso de uma das mais famosas personagens de animação dos últimos anos.","language":"por","IsPrimary":false},{"name":"קונג פו פנדה 3","language":"heb","IsPrimary":false},{"name":"Kung Fu Panda 3","language":"eng","IsPrimary":true},{"name":"Kung Fu Panda 3","language":"fra","IsPrimary":false},{"name":"Kung Fu Panda 3","language":"ita","IsPrimary":false},{"name":"Kung Fu Panda 3","language":"pt","IsPrimary":false},{"name":"Kung Fu Panda 3","language":"spa","IsPrimary":false},{"name":"Kung Fu Panda 3","tagline":"Sprawa wielkiej wagi","language":"pol","IsPrimary":false}],"overviewTranslations":[{"overview":"Воссоединившись со своим давно потерянным отцом, По отправляется в тайный рай для панд, где его ожидает встреча с множеством веселых сородичей. Однако вскоре злодей Кай начинает зачистку — он уничтожает кунг-фу мастеров по всему Китаю.\r\n\r\nПо предстоит сделать невозможное — обучить боевому искусству деревню, полную его веселых, неуклюжих собратьев, и тем самым превратить их в отряд кунг-фу панд.","language":"rus","IsPrimary":false},{"overview":"Depois de muito tempo desaparecido, o pai de Po reaparece, e juntos vão viajar para um paraíso secreto de pandas onde conhecem vários e hilariantes novos pandas. Mas quando o demoníaco vilão Kai começa a varrer a China derrotando todos os mestres de kung fu, Po tem de fazer o impossível – treinar uma aldeia cheia amigos desajeitados e torná-los no derradeiro grupo de Pandas do Kung Fu.","tagline":"O regresso de uma das mais famosas personagens de animação dos últimos anos.","language":"por","IsPrimary":false},{"overview":"Continuing his \"legendary adventures of awesomeness\", Po must face two hugely epic, but different threats: one supernatural and the other a little closer to his home.","language":"eng","IsPrimary":true},{"overview":"Po avait toujours cru son père panda disparu, mais le voilà qui réapparaît ! Enfin réunis, père et fils vont voyager jusqu’au village secret des pandas. Ils y feront la connaissance de certains de leurs semblables, tous plus déjantés les uns que les autres. Mais lorsque le maléfique Kaï décide de s’attaquer aux plus grands maîtres du kung-fu à travers toute la Chine, Po va devoir réussir l’impossible : transformer une horde de pandas maladroits et rigolards en experts des arts martiaux, les redoutables Kung Fu Pandas !","language":"fra","IsPrimary":false},{"overview":"Dopo essersi ricongiunto con il papà Li, che non vedeva da lungo tempo, Po raggiunge con lui il suo villaggio d'origine: un paradiso segreto dei panda in cui incontra una serie di esilaranti nuovi personaggi. La minaccia tuttavia è dietro l'angolo, quando il potente spirito maligno Kai inizia a terrorizzare l'intera Cina sconfiggendo tutti i maestri di kung fu, ci vorrà tutta l'abilità e l'audacia di Po per insegnare ai suoi maldestri e festaioli compagni panda l'arte del kung fu, e trasformarli così in una vera e propria squadra da combattimento.","language":"ita","IsPrimary":false},{"overview":"Depois de reencontrar o pai, Po precisa treinar os moradores de um vilarejo repleto de pandas atrapalhados e ajudá-los a derrotar um perigoso e malvado vilão.\r\n","language":"pt","IsPrimary":false},{"overview":"El malvado Kai, confinado en el reino de los espíritus desde hace 500 años, consigue arrebatarle el chi al maestro Oogway, lo que le permite regresar al mundo de los mortales. Po deberá hacer frente a dos desafíos épicos: uno, de origen sobrenatural; el otro, muy cerca de su hogar, con la aparición del que dice ser su padre biológico.","language":"spa","IsPrimary":false},{"overview":"Po i Potężna Piątka wracają w przezabawnej komedii dla całej rodziny! Gdy Po trafia do tajemniczej, rajskiej wioski zamieszanej przez beztroskie, lubiące zabawę i troszkę niezdarne pandy, postanawia dokonać niemożliwego - wytrenować je, stworzyć armię i pokonać złowrogiego Kaia, który przemierza Chiny, by zniszczyć wszystkich mistrzów kung-fu.","tagline":"Sprawa wielkiej wagi","language":"pol","IsPrimary":false}]},"companies":{"studio":[{"id":2055,"name":"DreamWorks Animation"}],"network":[],"production":[{"id":2048,"name":"20th Century Studios","slug":"20th-century-fox","primaryCompanyType":2,"companyType":{"companyTypeId":3,"companyTypeName":"Production Company"},"parentCompany":{"relation":{}}},{"id":2055,"name":"DreamWorks Animation","slug":"dreamworks-animation","country":"usa","primaryCompanyType":2,"activeDate":"1994-10-12","companyType":{"companyTypeId":3,"companyTypeName":"Production Company"},"parentCompany":{"id":"2074","name":"Universal Pictures","relation":{}}},{"id":10059,"name":"China Film Co.","slug":"china-film-co","primaryCompanyType":3,"companyType":{"companyTypeId":3,"companyTypeName":"Production Company"},"parentCompany":{"relation":{}}},{"id":32987,"name":"Pearl Studio","slug":"pearl-studio","primaryCompanyType":3,"companyType":{"companyTypeId":3,"companyTypeName":"Production Company"},"parentCompany":{"relation":{}}}],"distributor":[],"special_effects":[]},"production_countries":[{"id":261769,"country":"chn","name":"China"},{"id":261770,"country":"usa","name":"United States of America"}],"inspirations":[],"spoken_languages":"[eng]","first_release":{"country":"global","date":"2016-01-23"}}