,{id:166,tag:10,tagName:Relationship Types,name:Family,helpText:null},{id:175,tag:10,tagName:Relationship Types,name:Friends,helpText:null},{id:125,tag:5,tagName:Time Period,name:2010s,helpText:null}]","lists":[{"id":6101,"name":"Kung Fu Panda Franchise","url":"kung-fu-panda","isOfficial":true,"nameTranslations":["deu","eng","spa"],"overviewTranslations":"[deu,spa]","aliases":[],"score":0,"image":"","imageIsFallback":false},{"id":7355,"name":"DreamWorks - Collection","url":"7355","isOfficial":false,"nameTranslations":["eng","por"],"aliases":[],"score":15249346,"image":"","imageIsFallback":false},{"id":7390,"name":"Kung Fu Panda - Collection","url":"7390","isOfficial":false,"nameTranslations":["eng","por"],"aliases":[],"score":2168024,"image":"","imageIsFallback":false},{"id":7634,"name":"DreamWorks","overview":".Just DreamWorks.","url":"7634","isOfficial":false,"nameTranslations":["eng"],"overviewTranslations":"[eng]","aliases":[],"score":0,"image":"","imageIsFallback":false},{"id":14654,"name":"Animated 3D","overview":"","url":"14654","isOfficial":false,"nameTranslations":["eng"],"overviewTranslations":"[eng]","aliases":[],"score":30822720,"image":"","imageIsFallback":false},{"id":15930,"name":"Must Watch","overview":"","url":"15930","isOfficial":false,"nameTranslations":["eng"],"overviewTranslations":"[eng]","aliases":[],"score":156027115,"image":"","imageIsFallback":false},{"id":16060,"name":"Kung Fu Panda Collection","overview":"The Kung Fu Panda series are computer-animated action comedy films set in a version of China populated by humanoid talking animals, the plot revolves around a bumbling humanoid panda named Po who aspires to be a kung fu master.","url":"16060","isOfficial":false,"nameTranslations":["eng"],"overviewTranslations":"[eng]","aliases":[],"score":2402021,"image":"","imageIsFallback":false}],"translations":{"nameTranslations":[{"name":"カンフー・パンダ２","language":"jpn","IsPrimary":false},{"name":"쿵푸팬더 2","language":"kor","IsPrimary":false},{"name":"קונג פו פנדה 2","language":"heb","IsPrimary":false},{"name":"Kung Fu Panda 2","tagline":"Do estúdio que nos trouxe \"Shrek\", \"Madagáscar\" e \"O Panda do Kung Fu\"...","language":"por","IsPrimary":false},{"name":"功夫熊猫2","language":"zho","IsPrimary":false},{"name":"Кунг-фу Панда 2","language":"rus","IsPrimary":false},{"name":"Kung Fu Panda 2.","language":"hun","IsPrimary":false},{"name":"Kung Fu Panda 2","language":"eng","IsPrimary":true},{"name":"Kung Fu Panda 2","language":"ita","IsPrimary":false},{"name":"Kung Fu Panda 2","language":"pt","IsPrimary":false},{"name":"Kung Fu Panda 2","language":"spa","IsPrimary":false},{"name":"Kung Fu Panda 2","language":"deu","IsPrimary":false},{"name":"Kung Fu Panda 2","language":"fra","IsPrimary":false},{"name":"Kung Fu Panda 2","tagline":"Wielki mistrz powraca","language":"pol","IsPrimary":false}],"overviewTranslations":[{"overview":"Po vive agora o seu sonho como Guerreiro Dragão, protegendo o Vale da Paz ao lado dos seus amigos e companheiros mestres do Kung Fu, Os Cinco Sensacionais – Tigresa, Grou, Louva, Víbora e Macaco. Mas a nova vida de altamentivez de Po é ameaçada pela aparecimento de um formidável vilão, que planeia usar uma secreta e imparável arma para conquistar a China e destruir o Kung Fu. Está nas mãos de Po e d’ Os Cinco Sensacionais iniciar uma cruzada pela China, enfrentar esta ameaça e eliminá-la. Mas como poderá Po derrotar uma arma que pode destruir o Kung Fu? Terá de olhar para o seu passado e descobrir os segredos das suas misteriosas origens. Só então será capaz de libertar o poder de que necessita para vencer!","tagline":"Do estúdio que nos trouxe \"Shrek\", \"Madagáscar\" e \"O Panda do Kung Fu\"...","language":"por","IsPrimary":false},{"overview":"Панда По наконец-то исполнит свою мечту, станет Воином Дракона и со своими друзьями и мастерами кунг-фу — Неистовой Пятеркой — защитит Великую Долину от страшного злодея и его легиона…","language":"rus","IsPrimary":false},{"overview":"Po is now living his dream as The Dragon Warrior, protecting the Valley of Peace alongside his friends and fellow kung fu masters, The Furious Five - Tigress, Crane, Mantis, Viper and Monkey. But Po’s new life of awesomeness is threatened by the emergence of a formidable villain, who plans to use a secret, unstoppable weapon to conquer China and destroy kung fu. It is up to Po and The Furious Five to journey across China to face this threat and vanquish it. But how can Po stop a weapon that can stop kung fu? He must look to his past and uncover the secrets of his mysterious origins; only then will he be able to unlock the strength he needs to succeed.","language":"eng","IsPrimary":true},{"overview":"Po, diventato Guerriero Dragone, vive proteggendo la Valle della Pace con i suoi amici e compagni maestri di kung-fu, i temibili Cinque Cicloni. Ma la sua nuova vita è scossa da uno spaventoso criminale che ha in mente di utilizzare un'invincibile arma segreta per conquistare la Cina e distruggere il kung fu. Po sarà costretto a scavare nel passato per scoprire le proprie origini misteriose e tirar fuori così la forza necessaria a fronteggiare il nemico.","language":"ita","IsPrimary":false},{"overview":"Um vilão planeja usar uma arma secreta para conquistar a China e eliminar as artes marciais. Para evitar que isso aconteça, Po terá que descobrir a misteriosa origem do novo inimigo e reunir as forças necessárias para vencê-lo.\r\n","language":"pt","IsPrimary":false},{"overview":"La historia vuelve a recuperar el personaje de Po, que ahora vive su sueño como guerrero dragón protegiendo el valle de la paz junto a sus amigos los cinco furiosos. Pero Po será amenazado por un nuevo villano, que planea usar una imparable arma secreta para conquistar China y destruir el Kung Fu. Po se enfrentará a él, pero ¿cómo se puede parar un arma que puede destruir el Kung Fu?. Po deberá buscar en su pasado y descubrir los secretos de su misterioso origen, solo entonces podrá encontrar la fuerza que necesita.","language":"spa","IsPrimary":false},{"overview":"Mit geballten Fäusten und einem vollen Bauch begibt sich Po mit den Furiosen Fünf auf eine gefährliche Reise, um die Kunst des Kung-Fu vor einem neuen Feind zu retten.","language":"deu","IsPrimary":false},{"overview":"Le rêve de Po s’est réalisé. Il est devenu le Guerrier Dragon, qui protège la Vallée de la Paix avec ses amis les Cinq Cyclones : Tigresse, Grue, Mante, Vipère et Singe. Mais cette vie topissime est menacée par un nouvel ennemi, décidé à conquérir la Chine et anéantir le kung‐fu à l’aide d’une arme secrète et indestructible. Comment Po pourra‐t‐il triompher d’une arme plus forte que le kung‐fu ? Il devra se tourner vers son passé et découvrir le secret de ses mystérieuses origines. Alors seulement, il pourra libérer la force nécessaire pour vaincre.","language":"fra","IsPrimary":false},{"overview":"Po powraca w filmie \"Kung Fu Panda 2\", prześmiesznej kontynuacji nominowanej do Nagrody Akademii komedii ze studia Dreamworks Animation. Podczas pierwszej poważnej próby od czasu otrzymania tytułu Smoczego Wojownika, Po prowadzi Wielką Piątkę - przyjaciół i mistrzów Kung Fu – na poważną misję, by pokonać najbardziej niszczycielskiego przeciwnika w historii.","tagline":"Wielki mistrz powraca","language":"pol","IsPrimary":false}]},"contentRatings":[{"id":544,"name":"PG","country":"usa","description":"Parental guidance recommended","contentType":"movie","order":0,"fullname":"PG"}],"companies":{"studio":[{"id":2055,"name":"DreamWorks Animation"}],"network":[],"production":[{"id":2055,"name":"DreamWorks Animation","slug":"dreamworks-animation","country":"usa","primaryCompanyType":2,"activeDate":"1994-10-12","companyType":{"companyTypeId":3,"companyTypeName":"Production Company"},"parentCompany":{"id":"2074","name":"Universal Pictures","relation":{}}}],"distributor":[],"special_effects":[]},"production_countries":[{"id":261426,"country":"usa","name":"United States of America"}],"inspirations":[],"spoken_languages":"[eng]","first_release":{"country":"global","date":"2011-05-26"}}