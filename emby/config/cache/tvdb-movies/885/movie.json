e":"Producer","personName":"Frank Marshall","personImgURL":""},{"id":12161852,"peopleId":350153,"movieId":"885","type":7,"image":"","sort":4,"isFeatured":false,"url":"350153-michael-siegel","peopleType":"Producer","personName":"Michael Siegel","personImgURL":""},{"id":12161853,"peopleId":256396,"movieId":"885","type":7,"image":"","sort":9,"isFeatured":false,"url":"256396-steven-spielberg","peopleType":"Producer","personName":"Steven Spielberg","personImgURL":"https://artworks.thetvdb.com/banners/v4/actor/256396/photo/651bf27763daf.jpg"}],"budget":"140000000.00","boxOffice":"183300000.00","originalCountry":"usa","originalLanguage":"eng","studios":[{"id":28,"name":"Walt Disney Studios"}],"lists":[{"id":7627,"name":"Disney Live-action","overview":".Just Disney Live-action.","url":"7627","isOfficial":false,"nameTranslations":["eng"],"overviewTranslations":"[eng]","aliases":[],"score":0,"image":"","imageIsFallback":false},{"id":15741,"name":"Roald Dahl","overview":"Films based on works by Roald Dahl","url":"15741","isOfficial":false,"nameTranslations":["eng"],"overviewTranslations":"[eng]","aliases":[],"score":0,"image":"","imageIsFallback":false},{"id":15742,"name":"BFG Collection","overview":"","url":"15742","isOfficial":false,"nameTranslations":["eng"],"overviewTranslations":"[eng]","aliases":[],"score":0,"image":"","imageIsFallback":false}],"translations":{"nameTranslations":[{"name":"BFG：ビッグ・フレンドリー・ジャイアント","language":"jpn","IsPrimary":false},{"name":"Obr Dobr","language":"ces","IsPrimary":false},{"name":"마이 리틀 자이언트","language":"kor","IsPrimary":false},{"name":"Den store venlige kæmpe","language":"dan","IsPrimary":false},{"name":"Iso kiltti jätti","language":"fin","IsPrimary":false},{"name":"Большой и добрый великан","language":"rus","IsPrimary":false},{"name":"O Amigo Gigante","tagline":"O Mundo É Mais Gigantesco Do Que Podes Imaginar","language":"por","IsPrimary":false},{"name":"De GVR","language":"nld","IsPrimary":false},{"name":"BFG Blagi Fantasticni Gorostas","language":"hrv","IsPrimary":false},{"name":"Mi amigo el gigante","tagline":"El mundo es gigante. Más de lo que puedas imaginar.","language":"spa","IsPrimary":false},{"name":"BFG: Bardzo Fajny Gigant","language":"pol","IsPrimary":false},{"name":"圆梦巨人","language":"zho","IsPrimary":false},{"name":"SVJ - Stora vänliga jätten","language":"swe","IsPrimary":false},{"name":"SVK: Store Vennlige Kjempe","language":"nor","IsPrimary":false},{"name":"Le BGG - Le Bon gros géant","language":"fra","IsPrimary":false},{"name":"BFG - Big Friendly Giant","language":"deu","IsPrimary":false},{"name":"Il GGG - Il Grande Gigante Gentile","language":"ita","IsPrimary":false},{"name":"VDV - Veliki dobrodušni velikan","language":"slv","IsPrimary":false},{"name":"העי''ג","language":"heb","IsPrimary":false},{"name":"A barátságos óriás","language":"hun","IsPrimary":false},{"name":"The BFG","language":"eng","IsPrimary":true},{"name":"Suur Sõbralik Hiiglane","language":"est","IsPrimary":false},{"name":"العملاق الودود الضخم","language":"ara","IsPrimary":false}],"overviewTranslations":[{"overview":"В центре истории девочка по имени Софи, которая не смогла заснуть до полуночи и в окошко увидела огромного великана, который подходил к соседним домам и начинал дуть в окна спален. В полном соответствии со старинными поверьями и детскими страшилками, великан увидел Софи и унес к себе домой, в страну великанов.\r\nКак оказалось, он в этой самой стране был единственным добрым великаном: действуя в обстановке строжайшей секретности, он коллекционировал хорошие сны, которые по ночам раздавал детям. Уши у него устроены таким образом, что он слышит, что и о чем снится ребятам, и никогда не позволяет им видеть кошмары.","language":"rus","IsPrimary":false},{"overview":"A história de uma menina, Sofia, e do Amigo Gigante, que lhe apresenta as maravilhas e perigos do País dos Gigantes. O Amigo Gigante é simples, carinhoso e recusa comer humanos, ao contrário dos restantes habitantes do país dele...","tagline":"O Mundo É Mais Gigantesco Do Que Podes Imaginar","language":"por","IsPrimary":false},{"overview":"Adaptación del cuento de Roald Dahl sobre una niña que se alía con la Reina de Inglaterra y con un gigante bonachón para impedir una invasión de malvados gigantes que se preparan para comerse a todos los niños del país.","tagline":"El mundo es gigante. Más de lo que puedas imaginar.","language":"spa","IsPrimary":false},{"overview":"Sophie est une des pensionnaires d'un orphelinat londonien. Une nuit, la petite fille férue de lecture découvre un géant qui rode non loin de l'établissement. Celui-ci attrape bientôt l'enfant dans sa large main et l'emmène directement au royaume des géants. Sophie est très inquiète, car la littérature sur les géants précise que ceux-ci mangent les humains. Heureusement, son kidnappeur, qu'elle surnomme vite le Bon Gros Géant, ne se nourrit que d'étranges végétaux, les schnockombres et la frambouille. Il emmène ensuite Sophie en promenade avec lui pour lui expliquer son travail : attraper les rêves dans la nature avant de les mettre en flacon...","language":"fra","IsPrimary":false},{"overview":"Il GGG è un gigante, un Grande Gigante Gentile, molto diverso dagli altri abitanti del Paese dei Giganti che come San-Guinario e Inghiotticicciaviva si nutrono di esseri umani, preferibilmente bambini. E così una notte il GGG - che è vegetariano e si ciba soltanto di Cetrionzoli e Sciroppio - rapisce Sophie, una bambina che vive a Londra e la porta nella sua caverna. Inizialmente spaventata dal misterioso gigante, Sophie ben presto si rende conto che il GGG è in realtà dolce, amichevole e può insegnarle cose meravigliose. Il GGG porta infatti Sophie nel Paese dei Sogni, dove cattura i sogni che manda di notte ai bambini e le spiega tutto sulla magia e il mistero dei sogni.","language":"ita","IsPrimary":false},{"overview":"Sophie, a 10-year-old girl who lives in a London orphanage, stays awake reading through the nights due to her insomnia. At 3 in the morning, or what she calls the \"wikt:witching hour\", she sees an elderly giant outside her window. The giant captures her and takes her into Giant Country. There, he explains that Sophie must stay with him for the rest of her life because she saw him and must not be allowed to reveal the existence of giants. He also explains that she will put herself at risk if she goes out in the open, as nine other giants inhabit Giant Country, all of whom are man-eaters and favor the taste of children.","language":"eng","IsPrimary":true},{"overview":"Steven Spielbergi lavastatud fantastiline kogupere seiklusfilm tüdrukust ja hiiglasest, kes tutvustab talle Hiiglastemaa imesid ja ohtusid. SSH on ka ise hiiglane, kuid ta on Suur Sõbralik Hiiglane, kes erineb teistest Hiiglastemaa elanikest nagu öö ja päev. SSH viib Sophie ka Unenägudemaale, kus ta kogub unenägusid ja saadab neid lastele. Sophiele avaneb tõde unenägude maagiast ja salapärast.","language":"est","IsPrimary":false},{"overview":"صوفي فتاة بالغة الحذر، ومنكفئة على نفسها، تصادف في يوم من الأيام العملاق الودود الضخم الذي يتضح مع الوقت أن مظهره يختلف تمامًا عن جوهره، وبالرغم من مظهره المخيف، إلا أنه طيب وودود للغاية على خلاف أقرانه من العمالقة الذين يمقتونه بسبب رفضه لالتهام الصبية والفتيات مثلهم، وتتوثق العلاقة أكثر فأكثر بين صوفي والعملاق.","language":"ara","IsPrimary":false}]},"companies":{"studio":[{"id":2075,"name":"Walt Disney Studios"}],"network":[],"production":[{"id":2121,"name":"Amblin Entertainment","slug":"amblin-entertainment","primaryCompanyType":2,"companyType":{"companyTypeId":3,"companyTypeName":"Production Company"},"parentCompany":{"relation":{}}},{"id":2075,"name":"Walt Disney Studios","slug":"walt-disney-studios","primaryCompanyType":2,"companyType":{"companyTypeId":3,"companyTypeName":"Production Company"},"parentCompany":{"relation":{}}},{"id":35924,"name":"Reliance Entertainment","slug":"reliance-entertainment","country":"ind","primaryCompanyType":3,"companyType":{"companyTypeId":3,"companyTypeName":"Production Company"},"parentCompany":{"relation":{}}},{"id":42486,"name":"The Kennedy/Marshall Company","slug":"the-kennedymarshall-company","primaryCompanyType":3,"companyType":{"companyTypeId":3,"companyTypeName":"Production Company"},"parentCompany":{"relation":{}}},{"id":45725,"name":"Walden Media","slug":"walden-media","primaryCompanyType":3,"companyType":{"companyTypeId":3,"companyTypeName":"Production Company"},"parentCompany":{"relation":{}}}],"distributor":[],"special_effects":[]},"production_countries":[{"id":260088,"country":"usa","name":"United States of America"},{"id":260089,"country":"ind","name":"India"}],"inspirations":[],"spoken_languages":"[eng]","first_release":{"country":"global","date":"2016-06-01"}}